<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hector_qml_controls</name>
  <version>1.0.0</version>
  <description>The hector_qml_controls package</description>

  <maintainer email="fabian@sim.tu-darmstadt.de">Stefan Fabian</maintainer>
  <license>MIT</license>
  <author email="fabian@sim.tu-darmstadt.de">Stefan Fabian</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Interfaces the QML controls subscribe to or call at runtime. -->
  <exec_depend>e_stop_manager_msgs</exec_depend>
  <exec_depend>hector_gamepad_manager_msgs</exec_depend>
  <exec_depend>hector_launch_manager_msgs</exec_depend>
  <exec_depend>hector_multi_robot_msgs</exec_depend>
  <exec_depend>hector_rviz_plugins_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <exec_depend>qml6-module-qtmultimedia</exec_depend>
  <exec_depend>qml6-module-qtquick</exec_depend>
  <exec_depend>qml6-module-qtquick-controls</exec_depend>
  <!-- QtQuick.Effects: apt qml6-module-qtquick-effects has no rosdep key; currently only installed via qt6-declarative-dev -->
  <exec_depend>qml6-module-qtquick-layouts</exec_depend>
  <exec_depend>qml6-module-qtquick-window</exec_depend>
  <exec_depend>qml6_ros2_plugin</exec_depend>
  <exec_depend>ros_camera_server_qml6</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
